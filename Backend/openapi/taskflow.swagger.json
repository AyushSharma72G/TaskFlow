    "/projects/{projectId}/members": {
  "post": {
    "tags": ["Projects"],
    "summary": "Invite user to project by email",
    "description": "Owner only",
    "security": [{ "cookieAuth": [] }],
    "parameters": [
      { "$ref": "#/components/parameters/ProjectIdScoped" }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
